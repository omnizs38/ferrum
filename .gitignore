# Generated by Cargo
# will have compiled files and executables
target/

# Gauntlet downloads (Stockfish anchor, do not commit binaries/zips).
stockfish.exe
stockfish.zip
stockfish_sf19/
results/

# Training run artifacts (paired-game logs, intermediate specs)
training/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

__pycache__/

# User's personal Chess.com analysis (never commit)
tools/_game.pgn
tools/analyze_game.py

# Local tooling / environment (optional, user-specific)
.env
.env.*
!.env.example
.vscode/
.idea/
*.local

# Personal scratch files and local helper scripts (optional, never commit)
notes/
scratch/
tools/local_*.py
tools/scratch_*.py

# Gauntlet variant binaries copied out of target/ for A/B matches
ferrum-gamma
ferrum-alpha
ferrum-gamma.exe
ferrum-alpha.exe

# Local match logs and games
*.pgn
*.log
